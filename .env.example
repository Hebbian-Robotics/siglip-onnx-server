# GitHub Actions publishes one immutable tag per source commit. Pin a tag or
# digest in production instead of following `latest`.
SIGLIP_ONNX_IMAGE=ghcr.io/hebbian-robotics/siglip-onnx-server:2ff8691dd2477eb237f10215a0cfedef49a95bb1

# Durable host directories mounted read-only by deploy/compose.yaml. Do not use
# /tmp: a VM restart must not erase the model or ONNX Runtime.
SIGLIP_ARTIFACT_DIRECTORY=/var/lib/siglip-onnx/model
SIGLIP_ORT_LIBRARY_DIRECTORY=/var/lib/siglip-onnx/onnxruntime/lib
SIGLIP_LISTEN_ADDRESS=0.0.0.0
SIGLIP_HOST_PORT=8000

# In-container artifact paths. Compose supplies the same values explicitly;
# these entries keep the documented `docker run --env-file .env` path working.
SIGLIP_MODEL_MANIFEST_PATH=/models/manifest.json
SIGLIP_ONNX_MODEL_PATH=/models/text_model.onnx
SIGLIP_TOKENIZER_PATH=/models/tokenizer.json
SIGLIP_ORT_LIBRARY_PATH=/opt/onnxruntime/lib/libonnxruntime.so

SIGLIP_ONNX_OUTPUT_NAME=text_embeds
SIGLIP_PORT=8000
SIGLIP_ORT_SESSION_COUNT=3
SIGLIP_ORT_INTRA_OP_THREADS=4
SIGLIP_MAX_TEXT_BATCH_SIZE=32
SIGLIP_MAX_PENDING_TEXT_REQUESTS=32
RUST_LOG=info
